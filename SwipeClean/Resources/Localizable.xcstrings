        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash"
          }
        }
      }
    },
    "Корзина SwipeClean: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwipeClean Trash: %@"
          }
        }
      }
    },
    "Корзина пуста": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash is empty"
          }
        }
      }
    },
    "Крупные файлы": {
