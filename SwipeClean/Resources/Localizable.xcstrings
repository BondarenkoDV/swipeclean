        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emails are never opened: the app only sees the sender, subject, date and size. Links and attachments are never loaded, so phishing can't do harm."
          }
        }
      }
    },
    "Письма от 5 МБ: обычно с вложениями": {
