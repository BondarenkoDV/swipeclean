            "value": "Cache iOS clears on its own"
          }
        }
      }
    },
    "Лишнего не нашлось": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to clean"
          }
        }
      }
    },
    "Лишних писем нет": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No clutter in your mail"
          }
        }
      }
    },
    "Лишних писем: %lld · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clutter emails: %lld · %@"
          }
        }
      }
    },
    "Лишних: %lld": {
      "localizations": {
