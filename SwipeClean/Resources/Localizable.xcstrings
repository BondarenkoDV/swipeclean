          "stringUnit": {
            "state": "translated",
            "value": "%1$lld гр. · %#@extra@"
          },
          "substitutions": {
            "extra": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
