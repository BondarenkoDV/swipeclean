{
  "sourceLanguage": "ru",
  "strings": {
    "%@ · контактов: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · contacts: %lld"
          }
        }
      }
    },
    "%@ год": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ из %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
          }
        }
      }
    },
    "%@ отклонил запрос: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rejected the request: %2$@"
