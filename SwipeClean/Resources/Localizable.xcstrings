          }
        }
      }
    },
    "Влево — в корзину, вправо — оставить. Вверх — в избранное, вниз — решу позже.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left to trash, right to keep. Up to favorite, down to decide later."
          }
        }
      }
    },
    "Влево — удалить, вправо — оставить": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left to delete, right to keep"
          }
        }
      }
    },
