    "%lld фото не проверены: оригиналы только в iCloud. Откройте их в приложении Фото, чтобы они загрузились, и проверьте заново.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo wasn't checked: its original is only in iCloud. Open it in Photos to download it, then scan again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos weren't checked: their originals are only in iCloud. Open them in Photos to download them, then scan again."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld фото не проверено: оригинал только в iCloud. Откройте его в приложении Фото, чтобы он загрузился, и проверьте заново."
                }
              },
              "few": {
                "stringUnit": {
