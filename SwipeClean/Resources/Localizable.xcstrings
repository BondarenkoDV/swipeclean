            "value": "Passcode and Face ID"
          }
        }
      }
    },
    "SwipeClean": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwipeClean"
          }
        }
      }
    },
    "iCloud Mail подключена": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Mail connected"
          }
        }
      }
    },
    "iCloud не принял адрес или пароль. Нужен пароль приложения с account.apple.com, а не пароль Apple ID.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud rejected the address or password. Use an app-specific password from account.apple.com, not your Apple ID password."
          }
        }
      }
    },
    "iCloud отклонил запрос: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud rejected the request: %@"
          }
        }
      }
    },
    "iCloud слишком долго не отвечает. Попробуйте ещё раз.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is taking too long to respond. Try again."
          }
        }
      }
    },
    "iOS не даёт приложениям узнать, сколько занимают другие программы. Разбивка по приложениям — в Настройках → Основные → Хранилище iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn't let apps see how much space other apps use. For a per-app breakdown, open Settings → General → iPhone Storage."
          }
        }
      }
    },
    "iOS, другие приложения, их данные и кэши": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, other apps, their data and caches"
          }
        }
      }
    },
    "Адрес iCloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud address"
          }
        }
      }
    },
    "Адрес, пароль или имя папки содержат недопустимые символы.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address, password or mailbox name contains invalid characters."
          }
        }
      }
    },
    "Альбом «%@» удалён в приложении «Фото», поэтому фото только оставлено. Альбом убран с панели.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The album “%@” was deleted in Photos, so the photo was only kept. The album was removed from the bar."
          }
        }
      }
    },
    "Альбома больше нет": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album no longer exists"
          }
