        }
      }
    },
    "В «Удалённые» (%@), откуда можно вернуть в Почте: %lld. Место освободится после очистки «Удалённых».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To Trash (%@), recoverable in Mail: %lld. Space is freed once Trash is emptied."
          }
        }
      }
    },
    "В «Удалённые»: %lld писем · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to Trash: %lld emails · %@"
          }
        }
      }
    },
    "В ИЗБРАННОЕ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FAVORITE"
          }
        }
      }
    },
    "В избранное": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorited"
          }
        }
      }
    },
    "В каждой группе останется самый полный контакт, к нему добавятся номера, почта и адреса остальных.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each group keeps its most complete contact, with the numbers, emails and addresses of the others added to it."
          }
        }
      }
    },
    "В корзину": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash"
          }
        }
      }
    },
    "В корзину (%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash (%lld)"
          }
        }
      }
    },
    "В медиатеке нет видео.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no videos in your library."
